# Database (used by the db service in docker-compose.yml)
POSTGRES_DB=land_marketplace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Secret that signs the JWT tokens (HS256). Use at least 32 characters and keep it private.
JWT_SECRET=dev-only-secret-change-me-outside-local-development

# How long a login token stays valid, in minutes.
JWT_EXPIRATION_MINUTES=60

# Origin allowed to call the API from a browser (the Vite dev server).
CORS_ALLOWED_ORIGIN=http://localhost:5173
